# Porta do Servidor Backend
PORT=3001

# Chave de API do Google Gemini (obtenha em: https://aistudio.google.com/)
GEMINI_API_KEY=sua_chave_gemini_aqui

# Modelo Gemini (padrão recomendado: gemini-flash-lite-latest ou gemini-1.5-flash)
GEMINI_MODEL=gemini-flash-lite-latest

# URL do Webhook do n8n
N8N_WEBHOOK_URL=https://n8n.dmedia.com.br/webhook/e7561c7e-44bb-4dcf-8a43-a8adca53ae32

# Segurança: Permitir edição de Webhook e Chave de IA pela interface Web
# Deixe 'false' para impedir alterações públicas indesejadas. Defina 'true' para liberar edição no navegador.
ALLOW_CONFIG_EDITS=false
